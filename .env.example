# Bot token from @BotFather. Never commit the real value.
BOT_TOKEN=123456:replace-me

# Numeric chat id where payment notifications, questions and
# "contact manager" requests are delivered. The manager sends /myid to the bot
# to get it. Can also be a group with the bot in it (negative id).
ADMIN_CHAT_ID=

# Comma-separated numeric user ids allowed to use admin commands
# (/stats, /closing, /paid, /media, media upload). Defaults to ADMIN_CHAT_ID.
ADMIN_IDS=

# Manager username shown on "contact manager" / crypto buttons.
MANAGER_USERNAME=ZoeRai

# Invite links to the closed participant chats (one per group or the same link twice).
GROUP_LINK_WEEKEND=
GROUP_LINK_WEEKDAY=

# Unpaid reminder is sent this many hours after a group was chosen (spec: 18–24).
REMINDER_DELAY_HOURS=20

# Database. Postgres URL in production (Vercel + Neon sets DATABASE_URL automatically).
# Without it a local SQLite file is used.
# DATABASE_URL=postgresql://user:pass@host/db
DB_PATH=neurofinance.db

# --- Webhook mode (Vercel) -------------------------------------------------
# Random strings, letters/digits only, e.g. `openssl rand -hex 32`.
WEBHOOK_SECRET=
CRON_SECRET=
# Optional: public base URL, e.g. https://bot.neurogoals.club (defaults to the URL you open /api/setup on).
PUBLIC_URL=

# Media: a local file path or a Telegram file_id. Empty = skipped.
# Easier: the manager sends the photo/video note to the bot (see /media).
MEDIA_PORTRAIT=media/portrait.jpg
MEDIA_PROGRAM=media/program.jpg
MEDIA_VIDEO_NOTE=media/zoe_circle.mp4
